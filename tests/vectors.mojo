def verify[R: TProtocolReader, //](mut r: R, idx: Int) raises:
    """Read vector `idx` back and assert every value."""
    var head = Tuple[Int8, Int16](Int8(0), Int16(0))
    var chead = Tuple[Int8, Int](Int8(0), 0)
    var mhead = Tuple[Int8, Int8, Int](Int8(0), Int8(0), 0)
    _ = head
    _ = chead
    _ = mhead
    if idx == 0:
        r.read_struct_begin()
        head = r.read_field_begin()
        assert_equal(Int(head[0]), 8)
        assert_equal(Int(head[1]), 1)
        assert_equal(Int(r.read_i32()), 0)
        r.read_field_end()
        head = r.read_field_begin()
        assert_equal(Int(head[0]), 8)
        assert_equal(Int(head[1]), 2)
        assert_equal(Int(r.read_i32()), -1)
        r.read_field_end()
        head = r.read_field_begin()
        assert_equal(Int(head[0]), 8)
        assert_equal(Int(head[1]), 3)
        assert_equal(Int(r.read_i32()), 1)
        r.read_field_end()
        head = r.read_field_begin()
        assert_equal(Int(head[0]), 8)
        assert_equal(Int(head[1]), 4)
        assert_equal(Int(r.read_i32()), -2147483648)
        r.read_field_end()
        head = r.read_field_begin()
        assert_equal(Int(head[0]), 8)
        assert_equal(Int(head[1]), 5)
        assert_equal(Int(r.read_i32()), 2147483647)
        r.read_field_end()
        head = r.read_field_begin()
        assert_equal(Int(head[0]), 8)
        assert_equal(Int(head[1]), 6)
        assert_equal(Int(r.read_i32()), -12345)
        r.read_field_end()

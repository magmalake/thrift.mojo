"""Thrift wire vectors — GENERATED by tools/gen_vectors.py, do not edit.

The expected bytes come from Apache Thrift's own Python runtime
(`thrift.protocol.TCompactProtocol` / `TBinaryProtocol` over a
`TMemoryBuffer`). Each vector is replayed through our writers and the
bytes compared, then read back through our readers and every value
checked.
"""

from std.testing import assert_equal, assert_true

from thrift.protocol import (
    T_BOOL,
    T_BYTE,
    T_DOUBLE,
    T_I16,
    T_I32,
    T_I64,
    T_LIST,
    T_MAP,
    T_SET,
    T_STRING,
    T_STRUCT,
    T_UUID,
    TProtocolReader,
    TProtocolWriter,
)


def unhex(text: StringSlice) raises -> List[UInt8]:
    var out = List[UInt8]()
    var raw = text.as_bytes()
    if len(raw) % 2 != 0:
        raise Error(String("odd hex length"))
    for i in range(0, len(raw), 2):
        var hi = _nib(raw[i])
        var lo = _nib(raw[i + 1])
        out.append((hi << 4) | lo)
    return out^


def _nib(c: UInt8) raises -> UInt8:
    if c >= UInt8(48) and c <= UInt8(57):
        return c - 48
    if c >= UInt8(97) and c <= UInt8(102):
        return c - 87
    if c >= UInt8(65) and c <= UInt8(70):
        return c - 55
    raise Error(String("bad hex digit ", Int(c)))


def hex_of(data: Span[UInt8, _]) -> String:
    comptime H = "0123456789abcdef"
    var out = String()
    for b in data:
        out += H[byte= Int(b >> 4)]
        out += H[byte= Int(b & 0xF)]
    return out^


def nan_f64() -> Float64:
    var zero = Float64(0.0)
    return zero / zero


def inf_f64() -> Float64:
    return Float64(1.0) / Float64(0.0)


def is_nan_f64(v: Float64) -> Bool:
    return v != v


comptime VECTOR_COUNT = 13


def vector_name(idx: Int) raises -> String:
    if idx == 0:
        return String("i32_boundaries")
    if idx == 1:
        return String("i64_boundaries")
    if idx == 2:
        return String("small_ints")
    if idx == 3:
        return String("doubles")
    if idx == 4:
        return String("strings_and_binary")
    if idx == 5:
        return String("bools_as_fields")
    if idx == 6:
        return String("bools_in_list")
    if idx == 7:
        return String("field_id_deltas")
    if idx == 8:
        return String("nested_structs")
    if idx == 9:
        return String("list_of_structs")
    if idx == 10:
        return String("maps_and_sets")
    if idx == 11:
        return String("uuids")
    if idx == 12:
        return String("everything")
    raise Error(String("no such vector ", idx))


def vector_doc(idx: Int) raises -> String:
    if idx == 0:
        return String("i32 at both ends of the range plus the zigzag-sensitive small values")
    if idx == 1:
        return String("i64 min/max and the 10-byte varint they force")
    if idx == 2:
        return String("i8 and i16 at their boundaries")
    if idx == 3:
        return String("doubles including -0.0, infinities and a NaN")
    if idx == 4:
        return String("empty, ASCII, UTF-8 and raw binary payloads")
    if idx == 5:
        return String("bool field values, which the compact protocol folds into the type nibble")
    if idx == 6:
        return String("bool list elements, which are a whole byte (1 true, 2 false)")
    if idx == 7:
        return String("field ids that fit the 4-bit delta and ids that force the long form")
    if idx == 8:
        return String("a struct inside a struct inside a struct, exercising the field-id stack")
    if idx == 9:
        return String("a list whose elements are structs, plus an empty list and a long one")
    if idx == 10:
        return String("map headers (including the empty-map short circuit) and sets")
    if idx == 11:
        return String("the 16-byte UUID type")
    if idx == 12:
        return String("one struct touching every primitive and container at once")
    raise Error(String("no such vector ", idx))



            p.write_field_begin(T_DOUBLE, 5)
            ref _v = self.zmin.value()
            p.write_double(_v)
            p.write_field_end()
        if self.zmax:
            p.write_field_begin(T_DOUBLE, 6)
            ref _v = self.zmax.value()
            p.write_double(_v)
            p.write_field_end()
        if self.mmin:
            p.write_field_begin(T_DOUBLE, 7)
            ref _v = self.mmin.value()
            p.write_double(_v)
            p.write_field_end()
        if self.mmax:
            p.write_field_begin(T_DOUBLE, 8)
            ref _v = self.mmax.value()
            p.write_double(_v)
            p.write_field_end()
        p.write_field_stop()
        p.write_struct_end()



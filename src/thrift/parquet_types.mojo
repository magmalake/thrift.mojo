        """Encode this `BoundingBox`, fields in ascending id order."""
        p.write_struct_begin()
        p.write_field_begin(T_DOUBLE, 1)
        p.write_double(self.xmin)
        p.write_field_end()
        p.write_field_begin(T_DOUBLE, 2)
        p.write_double(self.xmax)
        p.write_field_end()
        p.write_field_begin(T_DOUBLE, 3)
        p.write_double(self.ymin)
        p.write_field_end()
        p.write_field_begin(T_DOUBLE, 4)
        p.write_double(self.ymax)
        p.write_field_end()

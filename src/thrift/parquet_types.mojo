"""The Apache Parquet metadata schema as Mojo structs.

GENERATED by tools/gen_types.py from spec/parquet.thrift — do not
edit by hand. Regenerate with `pixi run gen-types` after dropping a
newer parquet.thrift into spec/.

Every Thrift `struct`, `union` and `enum` in the IDL is here.
Optional fields are `Optional[T]`; required fields are validated on
read; unknown field ids are skipped so a file written by a newer
Parquet still decodes; `write` emits fields in ascending id order.

Enums are open: an unknown value round-trips as its integer rather
than raising, because Parquet adds codecs and encodings over time.
"""

from thrift.protocol import (
    T_BOOL,
    T_BYTE,
    T_DOUBLE,
    T_I16,
    T_I32,
    T_I64,
    T_LIST,
    T_STOP,
    T_STRING,
    T_STRUCT,
    T_UUID,
    TProtocolReader,
    TProtocolWriter,
    type_name,
)


struct Type(Copyable, Defaultable, Equatable, ImplicitlyCopyable, Movable, Writable):
    """Types supported by Parquet. These types are intended to be used in
    combination with the encodings to control the on disk storage format.
    For example INT16 is not included as a type since a good encoding of
    INT32 would handle this.
    """

    var value: Int32

    comptime BOOLEAN = Self(0)
    comptime INT32 = Self(1)
    comptime INT64 = Self(2)
    comptime INT96 = Self(3)
    comptime FLOAT = Self(4)
    comptime DOUBLE = Self(5)
    comptime BYTE_ARRAY = Self(6)
    comptime FIXED_LEN_BYTE_ARRAY = Self(7)

    def __init__(out self):
        self.value = 0

    @implicit
    def __init__(out self, value: Int32):
        self.value = value

    def __eq__(self, other: Self) -> Bool:
        return self.value == other.value

    def __ne__(self, other: Self) -> Bool:
        return self.value != other.value

    def name(self) -> String:
        """The IDL spelling, or `Type(n)` for a value we do not know."""
        if self.value == 0:
            return String("BOOLEAN")
        if self.value == 1:
            return String("INT32")
        if self.value == 2:
            return String("INT64")
        if self.value == 3:
            return String("INT96")
        if self.value == 4:
            return String("FLOAT")
        if self.value == 5:
            return String("DOUBLE")
        if self.value == 6:
            return String("BYTE_ARRAY")
        if self.value == 7:
            return String("FIXED_LEN_BYTE_ARRAY")
        return String("Type(", self.value, ")")

    def write_to(self, mut writer: Some[Writer]):
        writer.write(self.name())



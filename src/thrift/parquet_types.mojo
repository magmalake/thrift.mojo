struct SizeStatistics(Copyable, Defaultable, Movable):
    """A structure for capturing metadata for estimating the unencoded,
    uncompressed size of data written. This is useful for readers to
    estimate how much memory is needed to reconstruct data in their
    memory model and for fine grained filter pushdown on nested
    structures (the histograms contained in this structure can help
    determine the number of nulls at a particular nesting level and
    maximum length of lists).
    """

    var unencoded_byte_array_data_bytes: Optional[Int64]
    var repetition_level_histogram: Optional[List[Int64]]
    var definition_level_histogram: Optional[List[Int64]]

    def __init__(out self):
        self.unencoded_byte_array_data_bytes = None
        self.repetition_level_histogram = None
        self.definition_level_histogram = None

    def __init__(out self, *, copy: Self):
        self.unencoded_byte_array_data_bytes = copy.unencoded_byte_array_data_bytes.copy()
        self.repetition_level_histogram = copy.repetition_level_histogram.copy()
        self.definition_level_histogram = copy.definition_level_histogram.copy()

    def __init__(out self, *, deinit move: Self):
        self.unencoded_byte_array_data_bytes = move.unencoded_byte_array_data_bytes^
        self.repetition_level_histogram = move.repetition_level_histogram^
        self.definition_level_histogram = move.definition_level_histogram^

    def read[P: TProtocolReader, //](mut self, mut p: P) raises:
        """Decode one `SizeStatistics` from `p`, skipping fields we do not know."""
        p.read_struct_begin()
        while True:
            var _head = p.read_field_begin()
            if _head[0] == T_STOP:
                break
            if _head[1] == 1 and _head[0] == T_I64:
                var _v = Int64(0)
                _v = p.read_i64()
                self.unencoded_byte_array_data_bytes = _v
            elif _head[1] == 2 and _head[0] == T_LIST:
                var _v = List[Int64]()
                var _h16 = p.read_list_begin()
                if _h16[0] != T_I64:
                    raise Error(String("parquet: _v element type ",
                        type_name(_h16[0])))
                _v = List[Int64]()
                _v.reserve(_h16[1])
                for _ in range(_h16[1]):
                    var _e16 = Int64(0)
                    _e16 = p.read_i64()
                    _v.append(_e16)
                p.read_list_end()
                self.repetition_level_histogram = _v^
            elif _head[1] == 3 and _head[0] == T_LIST:
                var _v = List[Int64]()
                var _h16 = p.read_list_begin()
                if _h16[0] != T_I64:
                    raise Error(String("parquet: _v element type ",
                        type_name(_h16[0])))
                _v = List[Int64]()
                _v.reserve(_h16[1])
                for _ in range(_h16[1]):
                    var _e16 = Int64(0)
                    _e16 = p.read_i64()
                    _v.append(_e16)
                p.read_list_end()
                self.definition_level_histogram = _v^
            else:
                p.skip(_head[0])
            p.read_field_end()
        p.read_struct_end()

    def write[W: TProtocolWriter, //](self, mut p: W) raises:
        """Encode this `SizeStatistics`, fields in ascending id order."""
        p.write_struct_begin()
        if self.unencoded_byte_array_data_bytes:
            p.write_field_begin(T_I64, 1)
            ref _v = self.unencoded_byte_array_data_bytes.value()
            p.write_i64(_v)
            p.write_field_end()
        if self.repetition_level_histogram:
            p.write_field_begin(T_LIST, 2)
            ref _v = self.repetition_level_histogram.value()
            p.write_list_begin(T_I64, len(_v))
            for ref _e12 in _v:
                p.write_i64(_e12)
            p.write_list_end()
            p.write_field_end()
        if self.definition_level_histogram:
            p.write_field_begin(T_LIST, 3)
            ref _v = self.definition_level_histogram.value()
            p.write_list_begin(T_I64, len(_v))
            for ref _e12 in _v:
                p.write_i64(_e12)
            p.write_list_end()
            p.write_field_end()
        p.write_field_stop()
        p.write_struct_end()


struct BoundingBox(Copyable, Defaultable, Movable):
    """Bounding box for GEOMETRY or GEOGRAPHY type in the representation of
    min/max value pair of coordinates from each axis.
    """

    var xmin: Float64
    var xmax: Float64
    var ymin: Float64
    var ymax: Float64
    var zmin: Optional[Float64]
    var zmax: Optional[Float64]
    var mmin: Optional[Float64]
    var mmax: Optional[Float64]

    def __init__(out self):
        self.xmin = Float64(0)
        self.xmax = Float64(0)
        self.ymin = Float64(0)
        self.ymax = Float64(0)
        self.zmin = None
        self.zmax = None
        self.mmin = None
        self.mmax = None

    def __init__(out self, *, copy: Self):
        self.xmin = copy.xmin.copy()
        self.xmax = copy.xmax.copy()
        self.ymin = copy.ymin.copy()
        self.ymax = copy.ymax.copy()
        self.zmin = copy.zmin.copy()
        self.zmax = copy.zmax.copy()
        self.mmin = copy.mmin.copy()
        self.mmax = copy.mmax.copy()

    def __init__(out self, *, deinit move: Self):
        self.xmin = move.xmin
        self.xmax = move.xmax
        self.ymin = move.ymin
        self.ymax = move.ymax
        self.zmin = move.zmin^
        self.zmax = move.zmax^
        self.mmin = move.mmin^
        self.mmax = move.mmax^

    def read[P: TProtocolReader, //](mut self, mut p: P) raises:
        """Decode one `BoundingBox` from `p`, skipping fields we do not know."""
        var _seen_xmin = False
        var _seen_xmax = False
        var _seen_ymin = False
        var _seen_ymax = False
        p.read_struct_begin()
        while True:
            var _head = p.read_field_begin()
            if _head[0] == T_STOP:
                break
            if _head[1] == 1 and _head[0] == T_DOUBLE:
                self.xmin = p.read_double()
                _seen_xmin = True
            elif _head[1] == 2 and _head[0] == T_DOUBLE:
                self.xmax = p.read_double()
                _seen_xmax = True
            elif _head[1] == 3 and _head[0] == T_DOUBLE:
                self.ymin = p.read_double()
                _seen_ymin = True
            elif _head[1] == 4 and _head[0] == T_DOUBLE:
                self.ymax = p.read_double()
                _seen_ymax = True
            elif _head[1] == 5 and _head[0] == T_DOUBLE:
                var _v = Float64(0)
                _v = p.read_double()
                self.zmin = _v
            elif _head[1] == 6 and _head[0] == T_DOUBLE:
                var _v = Float64(0)
                _v = p.read_double()
                self.zmax = _v
            elif _head[1] == 7 and _head[0] == T_DOUBLE:
                var _v = Float64(0)
                _v = p.read_double()
                self.mmin = _v
            elif _head[1] == 8 and _head[0] == T_DOUBLE:
                var _v = Float64(0)
                _v = p.read_double()
                self.mmax = _v
            else:
                p.skip(_head[0])
            p.read_field_end()
        p.read_struct_end()
        if not _seen_xmin:
            raise Error(String("parquet.BoundingBox: missing required field xmin"))
        if not _seen_xmax:
            raise Error(String("parquet.BoundingBox: missing required field xmax"))
        if not _seen_ymin:
            raise Error(String("parquet.BoundingBox: missing required field ymin"))
        if not _seen_ymax:
            raise Error(String("parquet.BoundingBox: missing required field ymax"))

